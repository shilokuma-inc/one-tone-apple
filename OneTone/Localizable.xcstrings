    "Pick a single note such as A4. The knob and slider move in semitones." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A4 のような音名で 1 音を選びます。ノブとスライダーは半音ずつ動きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择 A4 等单个音名。旋钮和滑块按半音移动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇 A4 等單一音名。旋鈕和滑桿以半音移動。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A4 같은 음이름으로 한 음을 고릅니다. 노브와 슬라이더는 반음씩 움직입니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una sola nota, como A4. La perilla y el control deslizante se mueven por semitonos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une seule note, comme A4. Le bouton et le curseur avancent par demi-tons."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle einen einzelnen Ton wie A4. Regler und Schieberegler bewegen sich in Halbtönen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una singola nota, come A4. La manopola e il cursore si muovono a semitoni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma única nota, como A4. O botão giratório e o controle deslizante se movem em semitons."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите одну ноту, например A4. Ручка и ползунок двигаются по полутонам."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih satu not, seperti A4. Kenop dan penggeser bergerak per semitone."
          }
        }
      }
    },
