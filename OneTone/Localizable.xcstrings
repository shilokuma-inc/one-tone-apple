    "Frequency, volume, and waveform will return to %@ Hz, %lld%%, and %@, and the frequency mode to %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequency, volume, and waveform will return to %1$@ Hz, %2$lld%%, and %3$@, and the frequency mode to %4$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "周波数・音量・波形を %1$@ Hz・%2$lld%%・%3$@ に、周波数の指定方法を %4$@ に戻します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "频率、音量和波形将恢复为 %1$@ Hz、%2$lld%% 和 %3$@，频率模式将恢复为 %4$@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "頻率、音量和波形將回復為 %1$@ Hz、%2$lld%% 和 %3$@，頻率模式將回復為 %4$@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주파수, 음량, 파형이 %1$@ Hz, %2$lld%%, %3$@(으)로, 주파수 모드가 %4$@(으)로 돌아갑니다."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La frecuencia, el volumen y la forma de onda volverán a %1$@ Hz, %2$lld %% y %3$@, y el modo de frecuencia a %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La fréquence, la forme d’onde et le volume reviendront à %1$@ Hz, %3$@ et %2$lld %%, et le mode de fréquence à %4$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequenz, Lautstärke und Wellenform werden auf %1$@ Hz, %2$lld %%, %3$@ zurückgesetzt, und der Frequenzmodus wird auf %4$@ gesetzt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frequenza, forma d’onda e volume torneranno a %1$@ Hz, %3$@ e %2$lld%%, e la modalità di frequenza a %4$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frequência, a forma de onda e o volume voltarão para %1$@ Hz, %3$@ e %2$lld%%, e o modo de frequência para %4$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Частота, громкость и форма волны вернутся к значениям %1$@ Hz, %2$lld %% и %3$@, а режим частоты — к %4$@."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frekuensi, volume, dan bentuk gelombang akan kembali ke %1$@ Hz, %2$lld%%, dan %3$@, dan mode frekuensi ke %4$@."
          }
        }
      }
    },
